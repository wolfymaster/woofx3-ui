{
	admin off
	auto_https off
	persist_config off
}

# Railway sets PORT; 8080 is for running the image locally.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# /u/<slug> is the public user page, a separate build in /srv/u whose files
	# all sit under /u/ (vite.user-page.config.ts): woofx3.tv forwards only
	# /u/* here. A bare /u names no page, so it goes to the dashboard, as it
	# does at the edge on woofx3.tv.
	@userPageRoot path /u /u/
	redir @userPageRoot / 302

	handle /u/assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The page reads its slug from the path, so every other /u/ path gets its
	# HTML, never the dashboard's.
	handle /u/* {
		header Cache-Control "no-cache"
		rewrite * /u/index.html
		file_server
	}

	# Vite content-hashes every file under /assets/, so one never changes. A
	# missing asset stays a 404 instead of falling back to index.html: a tab
	# still running a previous deploy that asks for an old chunk must get an
	# error it can recover from, not HTML cached as JavaScript for a year.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Wouter routes on the client, so any other path that is not a file gets
	# index.html. no-cache makes browsers revalidate it and pick up a new deploy.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
