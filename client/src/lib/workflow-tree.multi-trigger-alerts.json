{
  "one": {
    "name": "Cheers",
    "trigger": {
      "type": "event",
      "event": "channel.cheer"
    },
    "tasks": [
      {
        "id": "rule_1",
        "type": "condition",
        "conditions": [
          {
            "field": "${trigger.data.amount}",
            "operator": "gte",
            "value": 100
          }
        ],
        "onTrue": ["a1", "a2"]
      },
      {
        "id": "a1",
        "type": "action",
        "action": "function",
        "parameters": {
          "message": "thanks"
        },
        "function": "twitch.chat.send",
        "dependsOn": ["rule_1"]
      },
      {
        "id": "a2",
        "type": "action",
        "action": "function",
        "parameters": {
          "message": "again"
        },
        "function": "twitch.chat.send",
        "dependsOn": ["a1"]
      }
    ],
    "id": "wf-cheers"
