{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "The companion window renders state, listens for the companion's state events, and calls the companion's own commands. Nothing else: all other work, opening URLs included, happens in Rust.",
  "windows": ["companion"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-start-pairing",
    "allow-cancel-pairing",
    "allow-open-verification-url",
    "allow-confirm-pairing",
    "allow-reject-pairing",
    "allow-unpair",
    "allow-install-update",
    "allow-get-integrations",
    "allow-set-endpoint-enabled",
    "allow-confirm-address",
    "allow-use-discovered",
    "allow-set-share-password",
    "allow-test-endpoint",
    "allow-reconnect-relay"
  ]
}
