{
  "productName": "woofx3 companion",
  "version": "0.1.0",
  "identifier": "tv.woofx3.companion",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "woofx3",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      },
      {
        "label": "companion",
        "create": false,
        "title": "woofx3 companion",
        "url": "companion/index.html",
        "width": 480,
        "height": 560,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: https:",
        "frame-src": "https: http://127.0.0.1:* http://localhost:*",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: https:",
        "frame-src": "https: http://127.0.0.1:* http://localhost:*",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2Q0YyQkM5NDA3MTdGREUKUldUZWYzRkF5U3ZQRnQxblVVK2ZKSmFYWWFhZ1U5QUhWZFE0WDFNaTFJSXVMNUZkZ21hNTRSUVAK",
      "endpoints": ["https://github.com/wolfymaster/woofx3-ui/releases/download/companion-latest/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
